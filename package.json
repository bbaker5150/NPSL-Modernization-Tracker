{
  "name": "modernization-project-tracker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "SharePoint-backed modernization portfolio and project pipeline tracker.",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 4173",
    "build": "vite build",
    "build:singlefile": "vite build --config vite.singlefile.config.mjs",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "test": "vitest run",
    "verify:singlefile": "node scripts/verifySingleFile.mjs",
    "smoke:singlefile": "node scripts/smoke-forge-srcdoc.mjs && node scripts/smoke-tasking.mjs",
    "build:reference-export": "vite build --config vite.reference-export.config.mjs",
    "verify:reference-export": "node scripts/verifyReferenceExport.mjs"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "jszip": "3.10.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "4.3.4",
    "jsdom": "25.0.1",
    "vite": "^6.4.3",
    "vitest": "4.1.8"
  }
}
